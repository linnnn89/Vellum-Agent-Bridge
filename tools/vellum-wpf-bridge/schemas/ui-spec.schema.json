{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vellum.design/schemas/ui-spec.schema.json",
  "title": "SemanticUiSpec",
  "description": "Semantic UI specification. Eight-digit IR colors use #AARRGGBB; source Vellum RGBA is converted before entering IR.",
  "type": "object",
  "required": ["version", "name", "type", "root"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["0.1"]
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["window", "page", "component"]
    },
    "width": {
      "minimum": 0,
      "type": "number"
    },
    "height": {
      "minimum": 0,
      "type": "number"
    },
    "theme": {
      "type": "string",
      "enum": ["light", "dark", "auto"]
    },
    "resources": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3}|[0-9A-Fa-f]{5})?$" }
    },
    "assets": {
      "type": "object",
      "description": "Embedded raster data URIs keyed by assetId; exported as local Assets files",
      "additionalProperties": { "type": "string", "pattern": "^data:image/(png|jpeg|gif|bmp|x-icon|tiff);base64," }
    },
    "root": {
      "$ref": "#/$defs/UiNode"
    }
  },
  "$defs": {
    "UiNode": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "generatedName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128 },
        "type": {
          "type": "string",
          "enum": [
            "window",
            "panel",
            "frame",
            "stack",
            "grid",
            "text",
            "button",
            "input",
            "image",
            "separator",
            "card",
            "badge",
            "icon",
            "unknown"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "format": { "type": "string" },
            "nodeId": { "type": "string" },
            "nodeName": { "type": "string" },
            "sourceType": { "type": "string" }
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["stack", "grid", "dock", "absolute", "none"] },
            "direction": { "type": "string", "enum": ["horizontal", "vertical"] },
            "gap": { "type": "number", "minimum": 0 },
            "padding": {
              "oneOf": [
                { "type": "number", "minimum": 0 },
                { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 4, "maxItems": 4 }
              ]
            },
            "align": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
            "crossAlign": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
            "widthMode": { "type": "string", "enum": ["fixed", "fill"] },
            "heightMode": { "type": "string", "enum": ["fixed", "fill"] },
            "constraintH": { "type": "string", "enum": ["left", "right", "center", "stretch", "scale"] },
            "constraintV": { "type": "string", "enum": ["top", "bottom", "center", "stretch", "scale"] },
            "designWidth": { "type": "number", "minimum": 0 },
            "designHeight": { "type": "number", "minimum": 0 },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "oneOf": [{ "type": "number", "minimum": 0 }, { "enum": ["Auto"] }] },
            "height": { "oneOf": [{ "type": "number", "minimum": 0 }, { "enum": ["Auto"] }] },
            "grow": { "type": "number", "minimum": 0 },
            "columns": { "type": "array", "items": { "oneOf": [{ "type": "number", "minimum": 0 }, { "enum": ["*", "Auto"] }] } },
            "rows": { "type": "array", "items": { "oneOf": [{ "type": "number", "minimum": 0 }, { "enum": ["*", "Auto"] }] } },
            "gridColumn": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "gridRow": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3}|[0-9A-Fa-f]{5})?$" },
            "foreground": { "type": "string", "pattern": "^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3}|[0-9A-Fa-f]{5})?$" },
            "borderColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3}|[0-9A-Fa-f]{5})?$" },
            "borderThickness": { "type": "number", "minimum": 0 },
            "cornerRadius": { "type": "number", "minimum": 0 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "fontSize": { "type": "number", "exclusiveMinimum": 0 },
            "fontWeight": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
            "fontFamily": { "type": "string" },
            "fontStyle": { "type": "string" },
            "textAlign": { "type": "string", "enum": ["left", "center", "right", "justify"] }
          }
        },
        "props": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "placeholder": { "type": "string" },
            "actionHint": { "type": "string" },
            "commandCandidate": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128 },
            "command": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128 },
            "tooltip": { "type": "string" },
            "accessibleName": { "type": "string" },
            "helpText": { "type": "string" },
            "semanticRole": { "type": "string" },
            "icon": { "type": "string" },
            "assetId": { "type": "string" }
          },
          "additionalProperties": true
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/UiNode" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
